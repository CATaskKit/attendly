# Copy to ".env" (local) and add the same vars in Vercel → Project → Settings → Environment Variables.
# Both are safe to expose to the browser; data is protected by Row-Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public URL of the deployed web app — used for emailed links (password reset,
# invites) so they never point at localhost (incl. inside the Android app).
VITE_SITE_URL=https://your-org.github.io/attendly
